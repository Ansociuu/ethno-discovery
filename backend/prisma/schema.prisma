generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String
  phone      String?
  avatarUrl  String?
  role       Role       @default(USER)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  otpCode    String?
  otpExpires DateTime?
  provider   String?
  providerId String?    @unique
  isVerified Boolean    @default(false)
  aiTrips    AiTrip[]
  bookings   Booking[]
  payments   Payment[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@map("users")
}

model Destination {
  id          Int        @id @default(autoincrement())
  nameVi      String
  nameEn      String
  slug        String     @unique
  province    String
  description String     @db.Text
  coverImage  String?
  images      Json
  altitude    Int?
  bestSeason  String?
  difficulty  Difficulty @default(EASY)
  latitude    Float?
  longitude   Float?
  featured    Boolean    @default(false)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  homestays   Homestay[]
  tours       Tour[]

  @@map("destinations")
}

model Tour {
  id             Int         @id @default(autoincrement())
  destinationId  Int
  hostId         Int?
  title          String
  slug           String      @unique
  description    String      @db.Text
  durationDays   Int
  maxGroupSize   Int
  pricePerPerson Decimal     @db.Decimal(12, 2)
  includes       Json
  excludes       Json
  itinerary      Json
  coverImage     String?
  images         Json
  active         Boolean     @default(true)
  featured       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  bookings       Booking[]
  reviews        Review[]
  destination    Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId], map: "tours_destinationId_fkey")
  @@map("tours")
}

model Homestay {
  id            Int         @id @default(autoincrement())
  hostId        Int?
  destinationId Int
  name          String
  slug          String      @unique
  description   String      @db.Text
  pricePerNight Decimal     @db.Decimal(12, 2)
  maxGuests     Int
  amenities     Json
  coverImage    String?
  images        Json
  address       String
  latitude      Float?
  longitude     Float?
  active        Boolean     @default(true)
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bookings      Booking[]
  destination   Destination @relation(fields: [destinationId], references: [id])
  reviews       Review[]

  @@index([destinationId], map: "homestays_destinationId_fkey")
  @@map("homestays")
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int
  bookableType  String
  tourId        Int?
  homestayId    Int?
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  totalPrice    Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  addOns        Json?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  homestay      Homestay?     @relation(fields: [homestayId], references: [id])
  tour          Tour?         @relation(fields: [tourId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  payment       Payment?

  @@index([homestayId], map: "bookings_homestayId_fkey")
  @@index([tourId], map: "bookings_tourId_fkey")
  @@index([userId], map: "bookings_userId_fkey")
  @@map("bookings")
}

model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  userId        Int
  amount        Decimal  @db.Decimal(12, 2)
  provider      String   @default("sepay")
  orderCode     String   @unique
  transactionId String?
  status        String   @default("pending")
  sePayData     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking  @relation(fields: [bookingId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "payments_userId_fkey")
  @@map("payments")
}

model AiTrip {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  preferences Json
  itinerary   Json
  isSaved     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "ai_trips_userId_fkey")
  @@map("ai_trips")
}

model Review {
  id              Int       @id @default(autoincrement())
  userId          Int
  reviewableType  String
  tourId          Int?
  homestayId      Int?
  rating          Int
  content         String    @db.Text
  images          Json
  verifiedBooking Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  homestay        Homestay? @relation(fields: [homestayId], references: [id])
  tour            Tour?     @relation(fields: [tourId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@index([homestayId], map: "reviews_homestayId_fkey")
  @@index([tourId], map: "reviews_tourId_fkey")
  @@index([userId], map: "reviews_userId_fkey")
  @@map("reviews")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemType  String
  itemId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemType, itemId])
  @@map("wishlists")
}

enum Role {
  USER
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}
